          "warmup": "mdi:timer-sand",
          "no_match": "mdi:sleep"
        }
      },
      "map": {
        "default": "mdi:map"
      },
      "team_a": {
        "default": "mdi:account-group"
      },
      "team_b": {
        "default": "mdi:account-group"
      },
      "team_a_score": {
        "default": "mdi:scoreboard"
      },
      "team_b_score": {
        "default": "mdi:scoreboard"
      },
      "team_a_maps_won": {
        "default": "mdi:trophy-outline"
      },
      "team_b_maps_won": {
        "default": "mdi:trophy-outline"
      },
      "best_of": {
        "default": "mdi:numeric"
      },
      "team_a_timeouts_left": {
        "default": "mdi:timer-outline"
      },
      "team_b_timeouts_left": {
        "default": "mdi:timer-outline"
      },
      "team_a_timeouts_used": {
        "default": "mdi:timer-check-outline"
